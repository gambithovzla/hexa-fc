          {t.disclaimer}
        </Typography>
        <Typography
          sx={{
            fontFamily:    MONO,
            fontSize:      '0.6rem',
            color:         C.textDim,
            letterSpacing: '2px',
            textTransform: 'uppercase',
          }}
        >
          {t.footerLine}
        </Typography>
      </Box>
    </Box>
  );
}
