              fontWeight:    700,
              mb:            '3px',
              textTransform: 'uppercase',
              letterSpacing: '0.1em',
            }}
          >
            {t.awaySP}
          </Typography>
          <Typography
            noWrap
            sx={{
              fontFamily: MONO,
              fontSize: '0.68rem',
              color: C.textMuted,
