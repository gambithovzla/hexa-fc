        borderBottom: `2px solid ${C.accent}`, borderRight: `2px solid ${C.accent}` }} />

      {/* Header */}
      <div style={{ fontFamily: MONO, fontSize: 7, color: C.textMuted, letterSpacing: 3, marginBottom: 12, textTransform: "uppercase" }}>
