      </Section>

      {/* ── Divider ── */}
      <Box sx={{ borderTop: `1px solid ${C.border}` }} />

      {/* ── Disclaimer / footer ── */}
      <Box
        component="footer"
        sx={{
          py:        { xs: 4, md: 6 },
          px:        { xs: 2, sm: 3 },
          textAlign: 'center',
          mt:        'auto',
