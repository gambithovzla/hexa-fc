const SUBTITLE = {
  en: 'The MLB Sports Oracle',
  es: 'El Oráculo MLB',
};

const TABS = [
  { value: 'game',    en: 'Single Game', es: 'Juego Individual' },
  { value: 'parlay',  en: 'Parlay',      es: 'Parlay'           },
  { value: 'bankroll', en: 'Bankroll',    es: 'Bankroll'         },
