        {label || 'OUT'}
      </Typography>
      {[0, 1, 2].map(i => (
        <Box key={i} sx={{
          width:        10,
          height:       10,
          borderRadius: '50%',
          bgcolor:      i < outs ? C.accent : 'transparent',
          border:       `1.5px solid ${i < outs ? C.accent : C.border}`,
        }} />
      ))}
    </Box>
  );
}

// ── Scoreboard ────────────────────────────────────────────────────────────────

function Scoreboard({ game, lang }) {
  const { innings: gameInnings, away, home, situation } = game;
