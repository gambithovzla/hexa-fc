          borderRadius:   '2px',
          '&:hover':      { color: C.textSecondary, bgcolor: C.border },
        }}
      >
        ⏏
      </Box>
    </Box>
    {showPricing && <PricingModal onClose={() => setShowPricing(false)} lang={lang} />}
