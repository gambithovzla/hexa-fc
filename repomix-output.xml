              Cancelar
            </Box>
            <Box
              component="button"
              type="submit"
              disabled={busy}
              sx={{ px: '12px', py: '4px', bgcolor: C.accent, border: 'none', borderRadius: '2px', color: '#fff', fontFamily: BARLOW, fontSize: '0.68rem', fontWeight: 700, cursor: busy ? 'default' : 'pointer', opacity: busy ? 0.6 : 1 }}
