        </div>
        <div style={{ display: "flex", flexDirection: "column", gap: 4 }}>
          <label style={{ fontFamily: MONO, fontSize: 7, color: C.textMuted, letterSpacing: 2, textTransform: "uppercase" }}>STAKE ($)</label>
          <div style={{ position: "relative" }}>
